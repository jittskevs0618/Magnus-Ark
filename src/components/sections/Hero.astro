---
// 03-CONTENT.md §1, restyled on the template's `.banner`/`#header` hero.
// No stock photo per 06-ASSETS.md — brand.css replaces the template's
// background photo with a plain hull→royal gradient.
---

<section class="banner" id="top">
  <div class="banner-pattern">
    <div class="container">
      <div class="row">
        <div class="col-md-10 col-md-offset-1">
          <h1 class="hero-line">
            Built to carry regulated digital entertainment in the Philippines.
          </h1>
          <p class="hero-sub">
            Magnus Ark is a Philippine corporation licensed and approved by
            PAGCOR as a Gaming System Administrator.
          </p>
          <p>
            <a href="#about" class="btn btn-outline-white btn-small btn-sentence hero-cta">Learn more</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The template's .banner{height:100%} resolves to just its content
     height (no ancestor defines a height for it to inherit), so the
     hero was only as tall as its text — leaving the CTA button sitting
     right where the About section's diagonal divider bleeds 64px
     upward into it. Explicit min-height + padding fixes both: a proper
     hero presence, and real clearance above the divider. */
  .banner {
    min-height: 78vh;
  }

  .banner-pattern {
    padding: clamp(120px, 16vh, 200px) 0 clamp(96px, 14vh, 160px);
  }

  .hero-line {
    opacity: 1 !important;
    padding-top: 0 !important;
    font-size: clamp(2rem, 5vw, 3.4em);
    max-width: 16ch;
    margin-inline: auto;
  }

  .hero-sub {
    color: #fff;
    font-size: 1.25em;
    max-width: 46ch;
    margin: 24px auto 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .hero-cta {
    margin-top: 32px;
    display: inline-block;
  }
</style>
