---
// 03-CONTENT.md §8, restyled on the template's `#contact` section. The
// template's form posts to a PHP mailer, which doesn't run on Vercel;
// per 04-BUILD-SPEC.md, until the Supabase-backed API route is wired up
// the form renders disabled with a mailto: fallback beneath it, rather
// than a form that silently fails.
const enquiryTypes = ["Partnership", "Regulatory", "Supplier", "Careers", "Press", "Other"];
---

<section id="contact" class="photo-bg contact-photo">
  <div class="diag-divider diag-divider--hull" aria-hidden="true" />
  <div class="container">
    <h1 class="section-heading">Talk to us</h1>
    <div class="row reveal">
      <div class="col-sm-10 col-sm-offset-1">
        <p>For partnership, regulatory, supplier, and press enquiries.</p>
      </div>
    </div>

    <div class="row contact-meta-row">
      <div class="col-sm-4 reveal-item" style={{ "--reveal-index": 0 }}>
        <div class="icon">A</div>
        <p class="contact-meta">{"{{TBD: registered office address}}"}</p>
      </div>
      <div class="col-sm-4 reveal-item" style={{ "--reveal-index": 1 }}>
        <div class="icon">E</div>
        <p class="contact-meta">{"{{TBD: email}}"}</p>
      </div>
      <div class="col-sm-4 reveal-item" style={{ "--reveal-index": 2 }}>
        <div class="icon">P</div>
        <p class="contact-meta">{"{{TBD: phone}}"}</p>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8 col-md-offset-2" id="contact-form">
        <form aria-describedby="contact-disabled-note">
          <fieldset disabled>
            <div class="row">
              <div class="col-sm-6 form-field">
                <label for="cm-name">Full name</label>
                <input class="form-control" type="text" name="cm-name" id="cm-name" />
              </div>
              <div class="col-sm-6 form-field">
                <label for="cm-email">Work email</label>
                <input class="form-control" type="email" name="cm-email" id="cm-email" />
              </div>
            </div>
            <div class="row">
              <div class="col-sm-6 form-field">
                <label for="cm-org">Organisation</label>
                <input class="form-control" type="text" name="cm-org" id="cm-org" />
              </div>
              <div class="col-sm-6 form-field">
                <label for="cm-type">Enquiry type</label>
                <select class="form-control" name="cm-type" id="cm-type">
                  {enquiryTypes.map((t) => <option>{t}</option>)}
                </select>
              </div>
            </div>
            <div class="form-field">
              <label for="comments">Message</label>
              <textarea class="_message" id="comments" name="comments" rows="5" />
            </div>
            <div class="form-group">
              <button type="submit" name="submit" class="btn btn-outline-white btn-big btn-sentence">
                Send enquiry
              </button>
            </div>
          </fieldset>
        </form>
        <p id="contact-disabled-note" class="contact-disabled-note">
          The enquiry form is not wired up yet — email us directly instead:
          {" "}<a href="mailto:{{TBD: email}}">{"{{TBD: email}}"}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  #contact {
    position: relative;
  }

  .contact-photo {
    background-image:
      linear-gradient(180deg, rgba(20, 25, 63, 0.92) 0%, rgba(20, 25, 63, 0.86) 100%),
      url("/images/contact-sunset.jpg");
  }

  #contact-form fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    opacity: 0.55;
  }

  .form-field {
    text-align: left;
    margin-bottom: 20px;
  }

  .form-field label {
    display: block;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.85em;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .contact-meta-row {
    margin-bottom: 40px;
  }

  .contact-disabled-note {
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95em;
  }

  .contact-disabled-note a {
    color: #fff;
    text-decoration: underline;
  }
</style>
