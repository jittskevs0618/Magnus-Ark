---
// Email-only contact, per the client: no address, no phone, and no form.
// (The template's form posted to a PHP mailer, which doesn't run on Vercel,
// and the disabled placeholder form that replaced it looked unfinished on a
// live site. A form can be added back later if it gets a working backend.)
const email = "inquiry@magnusark.ph";
---

<section id="contact" class="photo-bg contact-photo">
  <div class="diag-divider diag-divider--hull" aria-hidden="true" />
  <div class="container">
    <h1 class="section-heading">Talk to us</h1>
    <div class="row reveal">
      <div class="col-sm-10 col-sm-offset-1">
        <p>For partnership, supplier, and press enquiries.</p>
      </div>
    </div>

    <div class="contact-email reveal">
      <span class="contact-email__badge" aria-hidden="true">
        <i class="fa fa-envelope"></i>
      </span>
      <a class="contact-email__link" href={`mailto:${email}`}>{email}</a>
    </div>
  </div>
</section>

<style>
  #contact {
    position: relative;
  }

  .contact-photo {
    background-image:
      linear-gradient(180deg, rgba(20, 25, 63, 0.92) 0%, rgba(20, 25, 63, 0.86) 100%),
      url("/images/contact-sunset.jpg");
  }

  .contact-email {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .contact-email__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 10px 30px rgba(3, 25, 60, 0.35);
  }

  .contact-email__badge .fa {
    color: var(--ark-royal, #035aa6);
    font-size: 28px;
  }

  .contact-email__link {
    font-family: "Oswald", sans-serif;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #fff;
    text-decoration: none;
    border-bottom: 2px solid rgba(255, 255, 255, 0.35);
    padding-bottom: 4px;
    overflow-wrap: anywhere;
    transition: border-color 0.2s ease-out, color 0.2s ease-out;
  }

  .contact-email__link:hover,
  .contact-email__link:focus-visible {
    color: #fff;
    border-bottom-color: #fff;
  }
</style>
