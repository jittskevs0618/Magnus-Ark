---
// 03-CONTENT.md §3. No equivalent section in the template — built in its
// visual language (Oswald headings, centered band, statistics-row layout)
// on the royal accent color. The brass rule is the one carryover from the
// original design system's "brass marks a credential, nothing else" rule.
const items = [
  { label: "Regulator", value: "Philippine Amusement and Gaming Corporation" },
  { label: "Authority", value: "Gaming System Administrator" },
  { label: "Registered", value: "{{TBD: SEC registration number}}" },
];
---

<section id="credentials">
  <div class="diag-divider diag-divider--royal" aria-hidden="true" />
  <div class="container">
    <h1 class="section-heading">Licensed and accountable</h1>
    <div class="row reveal">
      <div class="col-sm-10 col-sm-offset-1">
        <p>
          Magnus Ark operates under a Gaming System Administrator authority
          issued and regulated by the Philippine Amusement and Gaming
          Corporation. Our systems, records, and operating procedures are
          subject to PAGCOR oversight.
        </p>
      </div>
    </div>

    <div class="credential-rule" aria-hidden="true"></div>

    <div class="row credential-row">
      {
        items.map((item, i) => (
          <div class="col-sm-4 reveal-item" style={{ "--reveal-index": i }}>
            <p class="credential-label">{item.label}</p>
            <p class="credential-value">{item.value}</p>
          </div>
        ))
      }
    </div>

    <p class="credential-footnote reveal">
      Accreditation details available to partners and counterparties on request.
    </p>
  </div>
</section>

<style>
  #credentials {
    color: #fff;
    text-align: center;
    padding: 6em 0;
  }

  #credentials p {
    color: rgba(255, 255, 255, 0.9);
  }

  .credential-rule {
    width: 120px;
    margin: 48px auto;
  }

  .credential-row {
    margin-top: 24px;
  }

  .credential-label {
    font-family: "Oswald", sans-serif;
    font-size: 0.85em;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7) !important;
    margin-bottom: 8px;
  }

  .credential-value {
    font-family: "Oswald", sans-serif;
    font-size: 1.3em;
    color: #fff !important;
  }

  .credential-footnote {
    margin-top: 40px;
    font-size: 0.9em;
    color: rgba(255, 255, 255, 0.7) !important;
  }
</style>
