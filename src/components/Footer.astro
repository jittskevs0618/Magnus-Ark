---
// Restyled on the template's `.footer` band: logo, legal links, copyright,
// and photo credits. No licensing/regulator line and no age statement —
// Magnus Ark is presented as a corporate technology company only.
//
// Entity name: the supplied logo lockup reads "Magnus Ark Holdings Corp.",
// confirmed with the client as the correct registered name.
---

<div class="footer">
  <div class="container">
    <div class="main-photo footer-logo">
      <img src="/logo-white.png" alt="Magnus Ark" height="32" width="208" loading="lazy" />
    </div>

    <nav class="footer-links" aria-label="Legal">
      <a href="/privacy">Privacy notice</a>
      <span aria-hidden="true">·</span>
      <a href="/terms">Terms</a>
    </nav>

    <p class="footer-copyright">© 2026 Magnus Ark Holdings Corp. All rights reserved.</p>

    <!--
      CC BY-SA requires attribution "in a manner reasonable to the medium" —
      these three background photos (hero, the band above Contact, Contact)
      are real photography from Wikimedia Commons, not fabricated
      "our office" claims. Keep this block while any of those three images
      stay in use.
    -->
    <p class="footer-photo-credit">
      Photography:{" "}
      <a href="https://commons.wikimedia.org/wiki/File:Bonifacio_Global_City_Skyline.jpg" target="_blank" rel="noopener noreferrer">Lawrence Ruiz</a>,{" "}
      <a href="https://commons.wikimedia.org/wiki/File:BalticServers_data_center.jpg" target="_blank" rel="noopener noreferrer">BalticServers.com</a>,{" "}
      <a href="https://commons.wikimedia.org/wiki/File:View_from_Grand_Hyatt_Manila_overlooking_Bonifacio_Global_City_and_Makati_skylines_at_sunset.jpg" target="_blank" rel="noopener noreferrer">Mickeyeva</a>{" "}
      via Wikimedia Commons,{" "}
      <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA</a>.
    </p>
  </div>
</div>

<style>
  .footer {
    border-top: 3px solid var(--ark-brass, #c9a24a);
    padding: 4em 0;
    text-align: center;
  }

  .footer-logo {
    margin-bottom: 24px;
  }

  .footer-links {
    margin: 20px 0;
    font-size: 0.9em;
  }

  .footer-links a {
    color: #fff;
  }

  .footer-links a:hover {
    color: var(--ark-royal, #3c98e8);
  }

  .footer-links span {
    color: rgba(255, 255, 255, 0.4);
    margin: 0 8px;
  }

  .footer-copyright {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85em;
    margin: 16px auto 0;
    max-width: 62ch;
  }

  .footer-photo-credit {
    font-size: 0.75em;
    margin-top: 8px;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-photo-credit a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: underline;
  }
</style>
